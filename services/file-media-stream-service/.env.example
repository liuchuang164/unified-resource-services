APP_ENV=development
FMS_LOG_LEVEL=INFO
FMS_API_VERSION=v1
FMS_STREAM_LEASE_SECONDS=300
FMS_MAX_FILENAME_LENGTH=180
FMS_INFRASTRUCTURE_MODE=inmemory

DATABASE_URL=postgresql+asyncpg://fms_local:fms_local_only@localhost:55432/file_media_stream
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=5

REDIS_URL=redis://localhost:56379/0
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_LEASE_TTL_SECONDS=30

MINIO_ENDPOINT=localhost:59000
MINIO_ACCESS_KEY=fms_local
MINIO_SECRET_KEY=fms_local_only_secret
MINIO_BUCKET=file-media-stream
MINIO_SECURE=false
MINIO_PRESIGNED_UPLOAD_TTL_SECONDS=900
MINIO_PRESIGNED_DOWNLOAD_TTL_SECONDS=300

MEDIA_PROVIDER_BASE_URL=
MEDIA_PROVIDER_API_TOKEN=
MEDIA_PROVIDER_TIMEOUT_SECONDS=5
