APP_ENV=development
LOG_LEVEL=INFO
DATA_CONTROL_BASE_URL=http://127.0.0.1:8000
DATA_CONTROL_TIMEOUT_SECONDS=15

# Development/test only. Production must use an asymmetric public key.
CAPABILITY_TOKEN_ALGORITHM=HS256
CAPABILITY_TOKEN_ISSUER=unified-access-plane
CAPABILITY_TOKEN_AUDIENCE=data-access-gateway
CAPABILITY_TOKEN_SHARED_SECRET=replace_with_a_long_random_development_secret
