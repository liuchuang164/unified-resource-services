APP_NAME=data-control-service
APP_ENV=development
AUTH_PROVIDER=development
LOG_LEVEL=INFO
CONTROL_DATABASE_URL=postgresql+asyncpg://data_control:change_me@localhost:5432/data_control
CONTROL_DATABASE_MIGRATION_URL=postgresql+psycopg://data_control:change_me@localhost:5432/data_control
POSTGRESQL_ADAPTER_ENABLED=true
POSTGRESQL_ADAPTER_REQUIRED=true
POSTGRESQL_ADAPTER_DATABASE_URL=postgresql+asyncpg://data_control:change_me@localhost:5432/data_target
REDIS_ADAPTER_ENABLED=true
REDIS_ADAPTER_REQUIRED=true
REDIS_URL=redis://localhost:6379/0
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=50
REDIS_DEFAULT_TTL_SECONDS=3600
REDIS_MAX_TTL_SECONDS=86400
REDIS_LOCK_DEFAULT_TTL_SECONDS=30
REDIS_LOCK_MAX_TTL_SECONDS=300
REDIS_KEY_PREFIX=dcs
REDIS_SCAN_DISABLED=true
REDIS_MAX_VALUE_BYTES=65536

MINIO_ADAPTER_ENABLED=true
MINIO_ADAPTER_REQUIRED=true
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=change_me
MINIO_SECRET_KEY=change_me
MINIO_CONNECT_TIMEOUT_SECONDS=3
MINIO_READ_TIMEOUT_SECONDS=30
MINIO_MAX_CONCURRENCY=20
MINIO_DEFAULT_BUCKET=dcs-objects
MINIO_AUTO_CREATE_BUCKETS=false
MINIO_MAX_OBJECT_SIZE_BYTES=52428800
MINIO_DEFAULT_PRESIGNED_UPLOAD_TTL_SECONDS=900
MINIO_DEFAULT_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
MINIO_MAX_PRESIGNED_TTL_SECONDS=3600
MINIO_ALLOWED_CONTENT_TYPES=application/pdf,image/png,image/jpeg,text/plain,application/json,audio/mpeg,audio/wav,video/mp4
MINIO_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.json,.mp3,.wav,.mp4
MINIO_MULTIPART_THRESHOLD_BYTES=10485760
MINIO_MULTIPART_PART_SIZE_BYTES=5242880
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CONNECT_TIMEOUT_SECONDS=10
MAX_TIMEOUT_MS=10000
DEFAULT_TIMEOUT_MS=5000
MAX_PAGE_LIMIT=100
MAX_BATCH_SIZE=100
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_ENABLED=true
AUDIT_FAIL_CLOSED_FOR_WRITES=true
AUDIT_PAYLOAD_MAX_BYTES=4096
MAX_REDIS_TTL_SECONDS=86400
MAX_OBJECT_SIZE_BYTES=10485760
MAX_PRESIGNED_URL_TTL_SECONDS=900
MAX_VECTOR_TOP_K=20
MAX_TIMESERIES_QUERY_DAYS=31
