APP_NAME=data-control-service
APP_ENV=development
AUTH_PROVIDER=development
LOG_LEVEL=INFO
CONTROL_DATABASE_URL=postgresql+asyncpg://data_control:change_me@localhost:5432/data_control
CONTROL_DATABASE_MIGRATION_URL=postgresql+psycopg://data_control:change_me@localhost:5432/data_control
POSTGRESQL_ADAPTER_ENABLED=true
POSTGRESQL_ADAPTER_REQUIRED=true
POSTGRESQL_ADAPTER_DATABASE_URL=postgresql+asyncpg://data_control:change_me@localhost:5432/data_target
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_STATEMENT_TIMEOUT_MS=5000
DATABASE_CONNECT_TIMEOUT_SECONDS=10
MAX_TIMEOUT_MS=10000
DEFAULT_TIMEOUT_MS=5000
MAX_PAGE_LIMIT=100
MAX_BATCH_SIZE=100
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=120
IDEMPOTENCY_TTL_SECONDS=86400
AUDIT_ENABLED=true
AUDIT_FAIL_CLOSED_FOR_WRITES=true
AUDIT_PAYLOAD_MAX_BYTES=4096
MAX_REDIS_TTL_SECONDS=86400
MAX_OBJECT_SIZE_BYTES=10485760
MAX_PRESIGNED_URL_TTL_SECONDS=900
MAX_VECTOR_TOP_K=20
MAX_TIMESERIES_QUERY_DAYS=31
