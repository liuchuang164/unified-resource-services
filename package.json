{
  "name": "unified-resource-services",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for three independently deployable resource microservices.",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "dev:file-media": "pnpm --filter @urs/file-media-service dev",
    "dev:data-control": "pnpm --filter @urs/data-control-service dev",
    "dev:external-integration": "pnpm --filter @urs/external-integration-service dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/node": "^22.15.0",
    "eslint": "^9.30.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4"
  }
}
